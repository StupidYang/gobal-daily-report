    {
      "role": "quotes",
      "title": "GDR 基础行情",
      "promptFile": "automation/prompts/quotes.md",
      "readModules": [
        "quotes"
      ],
      "ownedPaths": [
        "data/modules/quotes.json",
        "data/runs/quotes/"
      ],
      "ui": "必看资产 / 独立报价时点",
      "submissionPaths": [
        "data/inbox/batches/<batchId>.json (as an owned module in a complete bundle)"
      ],
      "publicationReceipt": "data/receipts/quotes/<runId>.json",
      "internalStep": true
    },
    {
      "role": "asia-equities",
      "title": "GDR A股港股板块",
