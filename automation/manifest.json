{
  "version": "tasks-v2",
  "repository": "StupidYang/gobal-daily-report",
  "publicationProtocol": "atomic-batch-v2",
  "policy": "Three external schedules, seven internal role contracts. One task submits a complete immutable batch including synthesis. No child tasks or acceptance schedules. Synthetic test success is not permission to resume production.",
