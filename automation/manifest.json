{
  "version": "modules-v1",
  "repository": "StupidYang/gobal-daily-report",
  "policy": "AI submits immutable candidates; code validates and promotes. Only synthesis owns the full report. Schedules are best-effort; production output is not completion until a receipt exists.",
  "tasks": [
    {
      "role": "quotes",
      "title": "GDR 基础行情",
      "timezone": "Asia/Singapore",
      "cron": "40 3,7,11,15,19,23 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=3,7,11,15,19,23;BYMINUTE=40;BYSECOND=0",
      "promptFile": "automation/prompts/quotes.md",
      "readModules": [
        "quotes"
      ],
      "ownedPaths": [
        "data/modules/quotes.json",
        "data/runs/quotes/"
      ],
      "ui": "必看资产 / 独立报价时点",
      "maxMinutes": 12,
      "submissionPaths": [
        "data/inbox/quotes/"
      ],
      "publicationReceipt": "data/receipts/quotes/<runId>.json"
    },
    {
      "role": "asia-equities",
      "title": "GDR A股港股板块",
      "timezone": "Asia/Singapore",
      "cron": "35 9,12,15,16 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=9,12,15,16;BYMINUTE=35;BYSECOND=0",
      "promptFile": "automation/prompts/asia-equities.md",
      "readModules": [
        "asia-equities",
        "macro",
        "news"
      ],
      "ownedPaths": [
        "data/modules/asia-equities.json",
        "data/runs/asia-equities/"
      ],
      "ui": "A股31行业 / 港股12行业热弱榜",
      "maxMinutes": 20,
      "submissionPaths": [
        "data/inbox/asia-equities/"
      ],
      "publicationReceipt": "data/receipts/asia-equities/<runId>.json"
    },
    {
      "role": "us-equities",
      "title": "GDR 美股科技投资",
      "timezone": "America/New_York",
      "cron": "35 9,12,16 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=9,12,16;BYMINUTE=35;BYSECOND=0",
      "promptFile": "automation/prompts/us-equities.md",
      "readModules": [
        "us-equities",
        "macro",
        "news"
      ],
      "ownedPaths": [
        "data/modules/us-equities.json",
        "data/runs/us-equities/"
      ],
      "ui": "美股科技 / 投资公司候选池与排名",
      "maxMinutes": 15,
      "submissionPaths": [
        "data/inbox/us-equities/"
      ],
      "publicationReceipt": "data/receipts/us-equities/<runId>.json"
    },
    {
      "role": "news",
      "title": "GDR 中国美国全球新闻",
      "timezone": "Asia/Singapore",
      "cron": "25 3,7,11,15,19,23 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=3,7,11,15,19,23;BYMINUTE=25;BYSECOND=0",
      "promptFile": "automation/prompts/news.md",
      "readModules": [
        "news"
      ],
      "ownedPaths": [
        "data/modules/news.json",
        "data/runs/news/"
      ],
      "ui": "综合时事库，保留非财经增量",
      "maxMinutes": 15,
      "submissionPaths": [
        "data/inbox/news/"
      ],
      "publicationReceipt": "data/receipts/news/<runId>.json"
    },
    {
      "role": "macro",
      "title": "GDR 宏观与资金",
      "timezone": "Asia/Singapore",
      "cron": "30 3,7,11,15,19,23 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=3,7,11,15,19,23;BYMINUTE=30;BYSECOND=0",
      "promptFile": "automation/prompts/macro.md",
      "readModules": [
        "macro",
        "quotes"
      ],
      "ownedPaths": [
        "data/modules/macro.json",
        "data/runs/macro/"
      ],
      "ui": "央行 / 经济数据 / ETF / 清算",
      "maxMinutes": 15,
      "submissionPaths": [
        "data/inbox/macro/"
      ],
      "publicationReceipt": "data/receipts/macro/<runId>.json"
    },
    {
      "role": "research",
      "title": "GDR 财报研报事件研究",
      "timezone": "Asia/Singapore",
      "cron": "45 3,7,11,15,19,23 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=3,7,11,15,19,23;BYMINUTE=45;BYSECOND=0",
      "promptFile": "automation/prompts/research.md",
      "readModules": [
        "research",
        "asia-equities",
        "us-equities",
        "news",
        "quotes"
      ],
      "ownedPaths": [
        "data/modules/research.json",
        "data/runs/research/"
      ],
      "ui": "事件触发研究 / 沿用原分析",
      "maxMinutes": 20,
      "submissionPaths": [
        "data/inbox/research/"
      ],
      "publicationReceipt": "data/receipts/research/<runId>.json"
    },
    {
      "role": "synthesis",
      "title": "GDR 每4小时综合发布",
      "timezone": "Asia/Singapore",
      "cron": "0 0,4,8,12,16,20 * * *",
      "rrule": "FREQ=DAILY;BYHOUR=0,4,8,12,16,20;BYMINUTE=0;BYSECOND=0",
      "promptFile": "automation/prompts/synthesis.md",
      "readModules": [
        "quotes",
        "asia-equities",
        "us-equities",
        "news",
        "macro",
        "research"
      ],
      "ownedPaths": [
        "data/modules/synthesis.json",
        "data/runs/synthesis/",
        "data/latest.json",
        "data/history-index.json",
        "history/"
      ],
      "ui": "首屏结论 / 完整24h报告 / 唯一报告发布者",
      "maxMinutes": 20,
      "submissionPaths": [
        "data/inbox/synthesis/"
      ],
      "publicationReceipt": "data/receipts/synthesis/<runId>.json"
    }
  ],
  "publicationProtocol": "candidate-gate-v1"
}
